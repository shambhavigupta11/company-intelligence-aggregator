# GitHub
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Reddit (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=company-intel/0.1

# BigQuery
GOOGLE_APPLICATION_CREDENTIALS=/path/to/bigquery-service-account.json
BIGQUERY_PROJECT_ID=your-gcp-project
BIGQUERY_DATASET=company_intel

# PostgreSQL (matches docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=company_intel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Kafka (matches docker-compose.yml)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Databricks (optional, for remote Spark jobs)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_token_here

# Flask
FLASK_ENV=development
FLASK_PORT=5050
